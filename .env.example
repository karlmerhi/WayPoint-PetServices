# Firebase Configuration - Replace with your own values
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCDEF123

# Twilio Configuration
EXPO_PUBLIC_TWILIO_ACCOUNT_SID=your_twilio_sid
EXPO_PUBLIC_TWILIO_AUTH_TOKEN=your_twilio_token

# Stripe Configuration
EXPO_PUBLIC_STRIPE_SECRET_KEY=your_stripe_key

# Gemini API Key
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# Google Maps Platform
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# App Configuration
# Use "development" to enable Firebase emulators, "production" for real services
EXPO_PUBLIC_APP_ENV=production 